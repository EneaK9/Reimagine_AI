# API keys (required for full features)
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_API_KEY=
# Optional: TypeSafe (https://console.typesafe.ai) for fast typed judgments —
# furniture shape matching, chat intent routing, instant simple 3D edits
TYPESAFE_API_KEY=

# App
DEBUG=false
APP_NAME=ReimagineAI
APP_VERSION=0.1.0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Models
GPT_MODEL=gpt-4.1-2025-04-14
SCENE_ANALYSIS_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-4.1-2025-04-14
GEMINI_ANALYSIS_MODEL=gemini-flash-latest
GEMINI_MODEL=gemini-3-pro-image-preview
IMAGE_TO_3D_MODEL=fal-ai/trellis-2
# Face/texture budget per generated furniture mesh (keeps GLBs phone-sized)
IMAGE_TO_3D_FACES=60000
IMAGE_TO_3D_TEXTURE=1024

# Scene geometry (measures the room from the photo; runs on CPU)
# Ruicheng/moge-2-vitl-normal is larger and more accurate than the default.
GEOMETRY_MODEL=Ruicheng/moge-2-vits-normal
GEOMETRY_RESOLUTION_LEVEL=3
# Load the geometry model at startup instead of on the first scene request
PRELOAD_DEPTH_MODEL=true

# Set automatically by docker-compose for the api service.
# For local (non-Docker) Homebrew Postgres, use:
# DATABASE_URL=postgresql+psycopg://reimagine:reimagine@127.0.0.1:5432/reimagine_ai
DATABASE_URL=postgresql+psycopg://reimagine:reimagine@db:5432/reimagine_ai

# Postgres password used by docker-compose (must match DATABASE_URL password)
POSTGRES_PASSWORD=reimagine
