# API keys (required for full features)
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_API_KEY=

# App
DEBUG=false
APP_NAME=ReimagineAI
APP_VERSION=0.1.0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Models
GPT_MODEL=gpt-4.1
SCENE_ANALYSIS_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-5-mini
GEMINI_ANALYSIS_MODEL=gemini-flash-latest
GEMINI_MODEL=gemini-3-pro-image-preview
IMAGE_TO_3D_MODEL=fal-ai/trellis-2

# Set automatically by docker-compose for the api service.
# For local (non-Docker) Homebrew Postgres, use:
# DATABASE_URL=postgresql+psycopg://reimagine:reimagine@127.0.0.1:5432/reimagine_ai
DATABASE_URL=postgresql+psycopg://reimagine:reimagine@db:5432/reimagine_ai

# Postgres password used by docker-compose (must match DATABASE_URL password)
POSTGRES_PASSWORD=reimagine
